rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profil pegawai / dosen. Dibaca publik karena halaman login mencari email
    // berdasarkan NIP / Lecture ID SEBELUM user login, dan halaman signup
    // mengecek duplikat NIP/email sebelum akun dibuat.
    // Tulis hanya boleh oleh pemilik dokumen (doc id = uid Firebase Auth).
    // TODO: pindahkan lookup NIP -> email ke Cloud Function agar tidak publik.
    match /students/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /lectures/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Data referensi yang dibaca di halaman signup (belum login).
    match /departments/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /courses/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Data pribadi: hanya pemilik.
    match /employees/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Sisanya (attendances, schedules, pesan, dll.): wajib login.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
